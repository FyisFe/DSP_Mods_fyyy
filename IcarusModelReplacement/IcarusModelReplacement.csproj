<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">C:\Program Files (x86)\Applications\Steam\steamapps\common\Dyson Sphere Program\DSPGAME_Data\Managed</GameManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">C:\Users\Yi\AppData\Roaming\r2modmanPlus-local\DysonSphereProgram\profiles\latest\BepInEx\core</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Include="..\GuguGaga\model\model.json;..\GuguGaga\model\mesh.bin.gz;..\GuguGaga\model\texture.png;..\GuguGaga\README.md"
          Link="model\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <Stage>$(IntermediateOutputPath)publish</Stage>
      <PluginStage>$(Stage)\BepInEx\plugins\IcarusModelReplacement</PluginStage>
    </PropertyGroup>
    <MakeDir Directories="$(ProjectDir)package;$(PluginStage)\tools;$(PluginStage)\model" />
    <Copy SourceFiles="README.md;MODEL_FORMAT.md;package\manifest.json;package\icon.png" DestinationFolder="$(Stage)" />
    <Copy SourceFiles="$(TargetPath);README.md;MODEL_FORMAT.md" DestinationFolder="$(PluginStage)" />
    <Copy SourceFiles="tools\export_model.py" DestinationFolder="$(PluginStage)\tools" />
    <Copy SourceFiles="$(TargetDir)model\model.json;$(TargetDir)model\mesh.bin.gz;$(TargetDir)model\texture.png;$(TargetDir)model\README.md" DestinationFolder="$(PluginStage)\model" />
    <Exec Command="powershell -NoProfile -Command &quot;Compress-Archive -Force -DestinationPath '$(ProjectDir)package\$(AssemblyName)-$(Version).zip' -Path '$(Stage)\*'&quot;" />
  </Target>
</Project>
